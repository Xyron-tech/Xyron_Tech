{
  "redirects": [
    { "source": "/store/:slug", "destination": "/wholesale/store/:slug", "permanent": true },
    { "source": "/store/:slug/:path*", "destination": "/wholesale/store/:slug/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api", "destination": "https://xyron-wholesale.onrender.com/api" },
    { "source": "/api/:path*", "destination": "https://xyron-wholesale.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
