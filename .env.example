NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
API_PROXY_TARGET=http://127.0.0.1:5000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
MONGODB_URI=mongodb://127.0.0.1:27017/xyron_wholesale
SUPER_ADMIN_NAME=Xyron Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
XYRON_PIN_DATABASE_PATH=

# Optional image storage: provide CLOUDINARY_URL or all three values below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set at build time for production when the API is hosted separately.
VITE_API_URL=
