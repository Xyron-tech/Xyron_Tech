  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev --workspace server\"",
    "build": "vite build && npm run check --workspace server",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test:api": "npm test --workspace server",
    "seed:super-admin": "npm run seed:super-admin --workspace server",
    "start:api": "npm run start --workspace server"
  },
  "dependencies": {
