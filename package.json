    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^22.3.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.5",
    "multer": "^2.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
